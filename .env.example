# Copy to .env and fill in the values. Never commit .env.

# Model that answers customers: ollama or anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_DIGEST=0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0
LLM_SEED=42
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512

# LLM-as-judge: JUDGE_MODEL must differ from LLM_MODEL
JUDGE_PROVIDER=ollama
JUDGE_MODEL=bespoke-minicheck:7b
# How faithfulness is judged: minicheck (passed calibration), claim-check, guardian or ragas
JUDGE_METHOD=minicheck

# Only for paid runs
ANTHROPIC_API_KEY=

# Embeddings for Chroma
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIGEST=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f

# Where Ollama listens
OLLAMA_URL=http://localhost:11434
# The Ollama version committed runs are made on. Ollama updates itself, and one update changed
# an answer (reports/drift.md), so a run CI checks refuses to start on another version.
# Turn off "Auto-download updates" in Ollama's settings. To move on: install, pin here, rerun.
OLLAMA_VERSION=0.40.15

# Retrieval settings. The defaults are the Stage 3 result, confirmed on holdout
# (reports/experiments.md, experiment 8); the baseline was TOP_K=5, RETRIEVAL=dense.
CHUNK_SIZE=500
CHUNK_MAX=800
CHUNK_MIN=100
TOP_K=8
# dense (cosine only), hybrid (cosine and BM25, rank-fused) or questions
# (cosine over each chunk and its example questions in data/chunk_questions.json)
RETRIEVAL=questions

# Answer check before the reply goes out: off or minicheck (app/checker.py).
# On a 4 GB GPU it swaps models and adds about 10 s per answer.
ANSWER_CHECK=minicheck
ANSWER_CHECK_MODEL=bespoke-minicheck:7b
ANSWER_CHECK_DIGEST=66607904c165445540331c2f005bb5120edd939008ba1fe1e75151ed827a7a00

# Recorded in every eval run (the baseline was v2)
PROMPT_VERSION=v5

# Fixed for eval runs
TEMPERATURE=0

# SQLite database for the MCP tools (Stage 6)
DB_PATH=data/app.db
