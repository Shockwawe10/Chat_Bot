# Copy to .env and fill in the values. Never commit .env.

# Model that answers customers: ollama or anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct

# LLM-as-judge: JUDGE_MODEL must differ from LLM_MODEL
JUDGE_PROVIDER=ollama
JUDGE_MODEL=phi4-mini:3.8b

# Only for paid runs
ANTHROPIC_API_KEY=

# Embeddings for Chroma
EMBEDDING_MODEL=nomic-embed-text

# Retrieval settings under test
CHUNK_SIZE=500
CHUNK_MAX=800
CHUNK_MIN=100
TOP_K=5

# Recorded in every eval run
PROMPT_VERSION=v1

# Fixed for eval runs
TEMPERATURE=0

# SQLite database for the MCP tools (Stage 6)
DB_PATH=data/app.db
