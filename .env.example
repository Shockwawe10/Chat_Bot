# Copy to .env and fill in the values. Never commit .env.

# Model that answers customers: ollama or anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b-instruct
LLM_DIGEST=0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0
LLM_SEED=42
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=512

# LLM-as-judge: JUDGE_MODEL must differ from LLM_MODEL
JUDGE_PROVIDER=ollama
JUDGE_MODEL=bespoke-minicheck:7b
# How faithfulness is judged: minicheck (passed calibration), claim-check, guardian or ragas
JUDGE_METHOD=minicheck

# Only for paid runs
ANTHROPIC_API_KEY=

# Embeddings for Chroma
EMBEDDING_MODEL=nomic-embed-text:v1.5
EMBEDDING_DIGEST=0a109f422b47e3a30ba2b10eca18548e944e8a23073ee3f3e947efcf3c45e59f

# Where Ollama listens
OLLAMA_URL=http://localhost:11434

# Retrieval settings under test
CHUNK_SIZE=500
CHUNK_MAX=800
CHUNK_MIN=100
TOP_K=5

# Answer check before the reply goes out: off or minicheck (app/checker.py)
ANSWER_CHECK=off
ANSWER_CHECK_MODEL=bespoke-minicheck:7b
ANSWER_CHECK_DIGEST=66607904c165445540331c2f005bb5120edd939008ba1fe1e75151ed827a7a00

# Recorded in every eval run
PROMPT_VERSION=v2

# Fixed for eval runs
TEMPERATURE=0

# SQLite database for the MCP tools (Stage 6)
DB_PATH=data/app.db
