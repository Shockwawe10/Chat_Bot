{
  "permissions": {
    "blockWritesOutsideWorkingDirectories": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_inline_python.py\"",
            "timeout": 10
          },            
          {
  "type": "command",
  "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_before_commit.py\"",
  "timeout": 60
},
{
  "type": "command",
  "command": "\"$CLAUDE_PROJECT_DIR/.venv/Scripts/python\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/tests_before_push.py\"",
  "timeout": 300
}
        ]
      }
    ]
  }
}
